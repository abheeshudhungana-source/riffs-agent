# Environment Variables Template for RIFFs
# Copy this file to .env and fill in your actual credentials
ANTHROPIC_API_KEY=your_anthropic_api_key_here
RIFFS_JWT_SECRET=
RIFFS_JWT_ISSUER=https://your-identity-provider.example
RIFFS_JWT_AUDIENCE=riffs-agent
# Optional: Set REDIS_URL if using a shared local Redis daemon (defaults to in-memory rate limiting)
REDIS_URL=
RIFFS_VOCAL_SECRET=
# Configure both values with a shared Upstash Redis/Vercel KV instance in staging.
KV_REST_API_URL=
KV_REST_API_TOKEN=
