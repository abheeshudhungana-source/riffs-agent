# Environment Variables Template for RIFFs
# Copy this file to .env and fill in your actual credentials
# Local-only convenience; ignored by deployed environments. Never mint demo tokens in staging or production.
RIFFS_ENABLE_DEMO_AUTH=true
ANTHROPIC_API_KEY=your_anthropic_api_key_here
RIFFS_JWT_SECRET=
RIFFS_JWT_ISSUER=https://your-identity-provider.example
RIFFS_JWT_AUDIENCE=riffs-agent
# Leave blank for local-only in-memory rate limiting; deployments must set shared Redis.
REDIS_URL=
# Set a fresh random value to enable local vocal approval; deployments must provide a secret.
RIFFS_VOCAL_SECRET=
# Configure both values with a shared Upstash Redis/Vercel KV instance in staging.
KV_REST_API_URL=
KV_REST_API_TOKEN=
